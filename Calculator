<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Calculator |</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Outfit:wght@300;500;700&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Outfit', sans-serif;
      background: #e8e4dc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .label {
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      color: #888;
      text-transform: uppercase;
      font-weight: 500;
    }

    .calc {
      background: #1c1c1e;
      border-radius: 28px;
      padding: 24px;
      width: 320px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.35), 0 0 0 1px #2c2c2e;
    }

    .display {
      background: #111;
      border-radius: 16px;
      padding: 20px 20px 14px;
      margin-bottom: 20px;
      min-height: 100px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: flex-end;
      overflow: hidden;
    }

    .expression {
      font-family: 'Space Mono', monospace;
      font-size: 0.8rem;
      color: #555;
      min-height: 18px;
      word-break: break-all;
    }

    .result {
      font-family: 'Space Mono', monospace;
      font-size: 2.4rem;
      font-weight: 700;
      color: #f5f5f0;
      word-break: break-all;
      transition: all 0.15s;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    button {
      border: none;
      border-radius: 14px;
      font-family: 'Outfit', sans-serif;
      font-size: 1.05rem;
      font-weight: 500;
      cursor: pointer;
      height: 60px;
      transition: transform 0.08s, filter 0.1s;
    }

    button:active { transform: scale(0.93); }

    .btn-num {
      background: #2c2c2e;
      color: #f5f5f0;
    }

    .btn-num:hover { filter: brightness(1.3); }

    .btn-op {
      background: #3a3a3c;
      color: #f5a623;
      font-weight: 700;
    }

    .btn-op:hover { filter: brightness(1.3); }

    .btn-fn {
      background: #3a3a3c;
      color: #aaa;
    }

    .btn-fn:hover { filter: brightness(1.3); }

    .btn-eq {
      background: linear-gradient(135deg, #f5a623, #f97316);
      color: #1c1c1e;
      font-weight: 700;
      font-size: 1.3rem;
    }

    .btn-eq:hover { filter: brightness(1.1); }

    .btn-zero { grid-column: span 2; }

    .error { color: #f43f5e !important; font-size: 1.4rem !important; }
  </style>
</head>
<body>
  <div class="label">Calculator — Parth Anjikar</div>

  <div class="calc">
    <div class="display">
      <div class="expression" id="expr"></div>
      <div class="result" id="result">0</div>
    </div>

    <div class="grid">
      <button class="btn-fn" onclick="clearAll()">AC</button>
      <button class="btn-fn" onclick="toggleSign()">+/−</button>
      <button class="btn-fn" onclick="percent()">%</button>
      <button class="btn-op" onclick="inputOp('/')">÷</button>

      <button class="btn-num" onclick="inputNum('7')">7</button>
      <button class="btn-num" onclick="inputNum('8')">8</button>
      <button class="btn-num" onclick="inputNum('9')">9</button>
      <button class="btn-op" onclick="inputOp('*')">×</button>

      <button class="btn-num" onclick="inputNum('4')">4</button>
      <button class="btn-num" onclick="inputNum('5')">5</button>
      <button class="btn-num" onclick="inputNum('6')">6</button>
      <button class="btn-op" onclick="inputOp('-')">−</button>

      <button class="btn-num" onclick="inputNum('1')">1</button>
      <button class="btn-num" onclick="inputNum('2')">2</button>
      <button class="btn-num" onclick="inputNum('3')">3</button>
      <button class="btn-op" onclick="inputOp('+')">+</button>

      <button class="btn-num btn-zero" onclick="inputNum('0')">0</button>
      <button class="btn-num" onclick="inputDot()">.</button>
      <button class="btn-eq" onclick="calculate()">=</button>
    </div>
  </div>

<script>
  let current = '0';
  let expression = '';
  let operator = null;
  let prevValue = null;
  let justCalc = false;

  const resEl = document.getElementById('result');
  const exprEl = document.getElementById('expr');

  function updateDisplay() {
    resEl.className = 'result';
    resEl.textContent = current.length > 10 ? parseFloat(current).toExponential(4) : current;
    exprEl.textContent = expression;
  }

  function inputNum(n) {
    if (justCalc) { current = n; expression = ''; justCalc = false; }
    else current = (current === '0') ? n : current + n;
    updateDisplay();
  }

  function inputDot() {
    if (justCalc) { current = '0.'; justCalc = false; }
    else if (!current.includes('.')) current += '.';
    updateDisplay();
  }

  function inputOp(op) {
    justCalc = false;
    if (prevValue !== null && operator) {
      calculate(true);
    }
    prevValue = parseFloat(current);
    operator = op;
    const opSymbols = { '+': '+', '-': '−', '*': '×', '/': '÷' };
    expression = current + ' ' + opSymbols[op];
    current = '0';
    updateDisplay();
  }

  function calculate(chain = false) {
    if (prevValue === null || !operator) return;
    const cur = parseFloat(current);
    let res;
    if (operator === '/' && cur === 0) {
      resEl.className = 'result error';
      resEl.textContent = 'Error';
      exprEl.textContent = 'Cannot divide by 0';
      prevValue = null; operator = null; current = '0';
      return;
    }
    if (operator === '+') res = prevValue + cur;
    else if (operator === '-') res = prevValue - cur;
    else if (operator === '*') res = prevValue * cur;
    else if (operator === '/') res = prevValue / cur;

    if (!chain) {
      const opSymbols = { '+': '+', '-': '−', '*': '×', '/': '÷' };
      expression = prevValue + ' ' + opSymbols[operator] + ' ' + cur + ' =';
    }

    current = String(parseFloat(res.toFixed(10)));
    prevValue = null;
    operator = null;
    justCalc = !chain;
    updateDisplay();
  }

  function clearAll() {
    current = '0'; expression = ''; operator = null; prevValue = null; justCalc = false;
    updateDisplay();
  }

  function toggleSign() {
    current = String(parseFloat(current) * -1);
    updateDisplay();
  }

  function percent() {
    current = String(parseFloat(current) / 100);
    updateDisplay();
  }

  document.addEventListener('keydown', e => {
    if (e.key >= '0' && e.key <= '9') inputNum(e.key);
    else if (e.key === '.') inputDot();
    else if (e.key === '+') inputOp('+');
    else if (e.key === '-') inputOp('-');
    else if (e.key === '*') inputOp('*');
    else if (e.key === '/') { e.preventDefault(); inputOp('/'); }
    else if (e.key === 'Enter' || e.key === '=') calculate();
    else if (e.key === 'Escape') clearAll();
    else if (e.key === 'Backspace') {
      if (current.length > 1) current = current.slice(0, -1);
      else current = '0';
      updateDisplay();
    }
  });

  updateDisplay();
</script>
</body>
</html>
